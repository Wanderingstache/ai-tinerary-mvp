# Set these in Railway → your app service → Variables (never put real values in GitHub)
CLAUDE_API_KEY=            # from console.anthropic.com (expires Oct 25, 2026)
DATABASE_URL=${{Postgres.DATABASE_URL}}   # Railway fills this in from the Postgres service
ACCESS_CODE=               # the passcode clients type on the home page (not case-sensitive; one shared code for everyone)
ADMIN_KEY=                 # your private password for the /admin cost page
# Optional
MAX_GENERATIONS_PER_TRIP=5 # safety cap on itinerary rebuilds per trip

# Beta scope for accommodation needs (all optional; shown defaults are what beta ships with).
# The beta intake targets a "typical"-minded, "able"-bodied traveler for now — only gluten is
# asked about, on its own, since it's common and easy to identify. "1" turns a category on,
# "0" turns it off. Flip these back on for real clients later — no code change needed.
NEEDS_PHYSICAL=0   # accessibility (wheelchair, stairs, elevator, etc.) — off for beta
NEEDS_NEURO=0      # neurodivergent / sensory needs — off for beta
NEEDS_HEALTH=0     # other health considerations (altitude, medication, etc.) — off for beta
NEEDS_DIET=0       # the general dietary list (vegetarian, vegan, kosher, halal, nut/shellfish
                   # allergy, dairy-free) — off for beta
NEEDS_GLUTEN=1     # gluten allergy / celiac, asked on its own — ON for beta
