{
  "name": "ai-tinerary",
  "version": "1.0.0",
  "private": true,
  "description": "ai-tinerary.com: intake + itinerary generation for Wandering Mustache",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "start": "node server/index.js",
    "dev:web": "vite",
    "dev:server": "node --watch server/index.js",
    "preview:build": "vite build --config vite.preview.config.js && node scripts/inline-preview.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^8.3.1"
  }
}
